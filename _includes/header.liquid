<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
        <ul class="navbar-nav about-section-nav justify-content-center">
          <li class="nav-item"><a class="nav-link" href="{{ '/' | relative_url }}#about-me">About Me</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ '/' | relative_url }}#education">Education</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ '/' | relative_url }}#research-vision">Research Vision</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ '/' | relative_url }}#research-interests">Research Interests</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ '/' | relative_url }}#news">News</a></li>
          <li class="nav-item">
            <a class="nav-link" href="{{ '/' | relative_url }}#selected-publications">Selected Projects and Publications</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ '/' | relative_url }}#earlier-research-experience">Earlier Research Experience</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ '/' | relative_url }}#awards-social-activities">Awards &amp; Social Activities</a>
          </li>
          <li class="nav-item"><a class="nav-link" href="{{ '/' | relative_url }}#tech-stack">Tech Stack</a></li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
